<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>لوحة إدارة دليل الحاج</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
        /* =================================================================
           إعدادات عامة
        ================================================================= */
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Cairo', system-ui, sans-serif; }
        :root { --primary: #075c52; --primary-dark: #043d36; --bg: #f4f7fc; --card-bg: #ffffff; --text: #1a2e35; --text-muted: #718096; --shadow: 0 8px 30px rgba(0,0,0,0.06); --radius: 20px; --gold: #c99625; --google-red: #ea4335; }
        body { background: var(--bg); color: var(--text); min-height: 100vh; display: flex; }

        /* =================================================================
           الشريط الجانبي (Sidebar)
        ================================================================= */
        .sidebar { width: 80px; background: var(--primary-dark); min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 20px 0; position: fixed; right: 0; top: 0; bottom: 0; z-index: 100; box-shadow: -4px 0 20px rgba(0,0,0,0.1); }
        .sidebar .logo { color: var(--gold); font-size: 28px; width: 50px; height: 50px; background: rgba(255,255,255,0.08); border-radius: 16px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(201,150,37,0.3); margin-bottom: 30px; }
        .sidebar nav { display: flex; flex-direction: column; gap: 8px; flex: 1; }
        .sidebar nav button { background: none; border: none; color: rgba(255,255,255,0.6); width: 50px; height: 50px; border-radius: 16px; font-size: 20px; cursor: pointer; transition: 0.3s; display: flex; align-items: center; justify-content: center; position: relative; }
        .sidebar nav button:hover { background: rgba(255,255,255,0.08); color: #fff; }
        .sidebar nav button.active { background: var(--gold); color: #fff; box-shadow: 0 8px 20px rgba(201,150,37,0.3); }
        .sidebar nav button .badge { position: absolute; top: 4px; left: 4px; background: #e53e3e; color: #fff; font-size: 9px; font-weight: 700; width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }

        /* =================================================================
           المحتوى الرئيسي
        ================================================================= */
        .main-content { flex: 1; margin-right: 80px; padding: 25px 30px 30px; min-height: 100vh; }
        .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px; }
        .topbar .greeting h2 { font-size: 22px; font-weight: 800; }
        .topbar .greeting p { color: var(--text-muted); font-size: 14px; }
        .topbar .actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
        .topbar .actions .date-badge { background: var(--card-bg); padding: 10px 18px; border-radius: 60px; font-size: 13px; font-weight: 600; box-shadow: var(--shadow); color: var(--text-muted); }
        .btn-primary { background: var(--primary); color: #fff; border: none; padding: 12px 24px; border-radius: 60px; font-weight: 700; font-size: 14px; cursor: pointer; transition: 0.3s; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 8px 20px rgba(7,92,82,0.2); }
        .btn-primary:hover { background: var(--primary-dark); transform: translateY(-2px); }
        .btn-outline { background: var(--card-bg); color: var(--text); border: 1px solid #e2e8f0; padding: 12px 20px; border-radius: 60px; font-weight: 600; font-size: 14px; cursor: pointer; transition: 0.3s; display: inline-flex; align-items: center; gap: 8px; }
        .btn-outline:hover { background: #f7fafc; border-color: var(--primary); }
        .btn-google { background: #fff; color: #1a2e35; border: 2px solid var(--google-red); padding: 10px 22px; border-radius: 60px; font-weight: 700; font-size: 14px; cursor: pointer; transition: 0.3s; display: inline-flex; align-items: center; gap: 8px; }
        .btn-google:hover { background: var(--google-red); color: #fff; transform: scale(1.02); border-color: var(--google-red); }
        .btn-google i { color: var(--google-red); }
        .btn-google:hover i { color: #fff; }
        .btn-google.disabled { opacity: 0.4; pointer-events: none; }

        /* =================================================================
           بطاقات الإحصائيات
        ================================================================= */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: var(--card-bg); padding: 22px 25px; border-radius: var(--radius); box-shadow: var(--shadow); border-right: 5px solid var(--primary); transition: 0.3s; }
        .stat-card:hover { transform: translateY(-4px); }
        .stat-card .label { font-size: 13px; color: var(--text-muted); font-weight: 600; }
        .stat-card .value { font-size: 32px; font-weight: 800; margin: 5px 0 2px; }
        .stat-card .icon { float: left; font-size: 32px; opacity: 0.5; }
        .stat-card.gold { border-right-color: var(--gold); }

        /* =================================================================
           شريط الأدوات والجدول
        ================================================================= */
        .toolbar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 25px; background: var(--card-bg); padding: 12px 20px; border-radius: var(--radius); box-shadow: var(--shadow); }
        .search-box { display: flex; align-items: center; background: var(--bg); border-radius: 60px; padding: 4px 15px; flex: 1; min-width: 200px; border: 1px solid transparent; transition: 0.3s; }
        .search-box:focus-within { border-color: var(--gold); background: #fff; }
        .search-box i { color: var(--text-muted); margin-left: 10px; }
        .search-box input { border: none; background: transparent; padding: 12px 0; width: 100%; font-size: 14px; outline: none; }
        .left-actions { display: flex; gap: 10px; align-items: center; }

        .table-wrapper { background: var(--card-bg); border-radius: var(--radius); padding: 5px 0; box-shadow: var(--shadow); overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        th { text-align: right; padding: 16px 20px; background: var(--bg); color: var(--text-muted); font-weight: 700; border-bottom: 2px solid #e2e8f0; font-size: 12px; text-transform: uppercase; }
        td { padding: 14px 20px; border-bottom: 1px solid #edf2f7; vertical-align: middle; }
        tr:hover td { background: #f8fafc; }
        .pilgrim-avatar { width: 40px; height: 40px; border-radius: 12px; background: #e6f2ef; color: var(--primary); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 16px; }
        .status-badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 60px; font-size: 12px; font-weight: 600; }
        .status-badge.active { background: #c6f6d5; color: #276749; }
        .status-badge.inactive { background: #edf2f7; color: #4a5568; }
        .status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
        .status-dot.green { background: #48bb78; }
        .status-dot.gray { background: #a0aec0; }
        .action-btns { display: flex; gap: 6px; flex-wrap: wrap; }
        .action-btns button { border: none; width: 34px; height: 34px; border-radius: 10px; font-size: 14px; cursor: pointer; transition: 0.2s; display: inline-flex; align-items: center; justify-content: center; background: var(--bg); color: var(--text-muted); }
        .action-btns button:hover { transform: scale(1.1); }
        .action-btns .loc-btn:hover { background: #ebf8ff; color: #2b6cb0; }
        .action-btns .edit-btn:hover { background: #fefcbf; color: #d69e2e; }
        .action-btns .del-btn:hover { background: #fed7d7; color: #e53e3e; }

        /* =================================================================
           مودال الخريطة المتطور
        ================================================================= */
        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 2000; justify-content: center; align-items: center; padding: 10px; }
        .modal-overlay.show { display: flex; }
        .modal-box.map-modal { 
            background: #fff; 
            border-radius: 28px; 
            padding: 0; 
            max-width: 850px; 
            width: 100%; 
            height: 90vh; 
            max-height: 720px;
            display: flex; 
            flex-direction: column; 
            overflow: hidden; 
            animation: modalIn 0.3s ease;
            box-shadow: 0 30px 60px rgba(0,0,0,0.5);
        }
        @keyframes modalIn { from { opacity: 0; transform: scale(0.95) translateY(20px); } to { opacity: 1; transform: scale(1) translateY(0); } }
        
        .map-header { 
            padding: 15px 20px; 
            background: var(--primary-dark); 
            color: white; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            flex-shrink: 0;
        }
        .map-header h2 { font-size: 18px; font-weight: 700; }
        .map-header h2 i { margin-left: 8px; }
        .map-header .close-modal { background: none; border: none; color: white; font-size: 28px; cursor: pointer; opacity: 0.8; }
        .map-header .close-modal:hover { opacity: 1; }
        
        .map-toolbar { 
            padding: 10px 15px; 
            background: #f8fafc; 
            display: flex; 
            gap: 10px; 
            flex-wrap: wrap; 
            align-items: center; 
            border-bottom: 1px solid #e2e8f0;
            flex-shrink: 0;
        }
        .map-toolbar .search-input { 
            flex: 1; 
            padding: 10px 15px; 
            border: 1px solid #e2e8f0; 
            border-radius: 60px; 
            font-size: 14px; 
            outline: none; 
            background: white;
            min-width: 150px;
        }
        .map-toolbar .search-input:focus { border-color: var(--primary); }
        .map-toolbar .btn-icon { 
            background: var(--primary); 
            color: white; 
            border: none; 
            width: 42px; 
            height: 42px; 
            border-radius: 50%; 
            font-size: 18px; 
            cursor: pointer; 
            transition: 0.2s; 
            display: flex; 
            align-items: center; 
            justify-content: center;
            flex-shrink: 0;
        }
        .map-toolbar .btn-icon:hover { background: var(--primary-dark); transform: scale(1.05); }
        .map-toolbar .btn-icon.gold { background: var(--gold); }
        .map-toolbar .btn-icon.gold:hover { background: #b8860b; }
        
        #locationMap { 
            flex: 1; 
            width: 100%; 
            background: #e2e8f0; 
            min-height: 280px;
        }
        
        .map-footer { 
            padding: 15px 20px; 
            background: white; 
            border-top: 1px solid #e2e8f0; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            flex-wrap: wrap; 
            gap: 10px;
            flex-shrink: 0;
        }
        .map-footer .address-info { 
            display: flex; 
            align-items: center; 
            gap: 10px; 
            font-size: 14px; 
            color: var(--text-muted);
            flex: 1;
            min-width: 150px;
        }
        .map-footer .address-info i { color: var(--gold); font-size: 18px; }
        .map-footer .address-info span { direction: ltr; text-align: left; }
        .map-footer .btn-group { display: flex; gap: 10px; flex-wrap: wrap; flex-shrink: 0; }
        .map-footer .btn-save-location { 
            background: var(--primary); 
            color: white; 
            border: none; 
            padding: 10px 22px; 
            border-radius: 60px; 
            font-weight: 700; 
            cursor: pointer; 
            transition: 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .map-footer .btn-save-location:hover { background: var(--primary-dark); transform: scale(1.02); }

        /* =================================================================
           مودال الإضافة / التعديل
        ================================================================= */
        .modal-box { background: var(--card-bg); border-radius: 32px; padding: 30px; max-width: 550px; width: 100%; max-height: 90vh; overflow-y: auto; animation: modalIn 0.3s ease; box-shadow: 0 30px 60px rgba(0,0,0,0.2); }
        .modal-box .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .modal-box .modal-header h2 { color: var(--primary); font-size: 22px; }
        .modal-box .modal-header .close-modal { background: none; border: none; font-size: 28px; color: var(--text-muted); cursor: pointer; }
        .modal-box .form-group { margin-bottom: 16px; }
        .modal-box .form-group label { display: block; font-weight: 600; font-size: 13px; color: var(--text-muted); margin-bottom: 5px; }
        .modal-box .form-group input { width: 100%; padding: 14px 16px; border: 2px solid #e2e8f0; border-radius: 14px; font-size: 15px; transition: 0.3s; background: var(--bg); }
        .modal-box .form-group input:focus { border-color: var(--primary); outline: none; background: #fff; }
        .modal-box .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .modal-box .btn-save { width: 100%; padding: 16px; background: var(--primary); color: #fff; border: none; border-radius: 60px; font-weight: 700; font-size: 16px; cursor: pointer; margin-top: 10px; transition: 0.3s; }
        .modal-box .btn-save:hover { background: var(--primary-dark); }

        /* =================================================================
           Toast
        ================================================================= */
        #toast { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%) translateY(100px); background: var(--text); color: #fff; padding: 14px 28px; border-radius: 60px; font-weight: 600; z-index: 9999; opacity: 0; transition: all 0.4s ease; display: flex; align-items: center; gap: 10px; white-space: nowrap; max-width: 90%; }
        #toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
        #toast.error { background: #b91c1c; }
        .skeleton { background: linear-gradient(90deg, #edf2f7 25%, #e2e8f0 50%, #edf2f7 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; border-radius: 8px; }
        @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }

        /* =================================================================
           استجابة
        ================================================================= */
        @media (max-width: 768px) {
            .sidebar { width: 60px; padding: 15px 0; }
            .sidebar .logo { font-size: 20px; width: 40px; height: 40px; }
            .sidebar nav button { width: 40px; height: 40px; font-size: 16px; }
            .main-content { margin-right: 60px; padding: 15px; }
            .topbar .greeting h2 { font-size: 18px; }
            .stats-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
            .stat-card { padding: 16px; }
            .stat-card .value { font-size: 24px; }
            .modal-box .form-row { grid-template-columns: 1fr; }
            .toolbar { flex-direction: column; align-items: stretch; }
            .search-box { width: 100%; }
            .topbar .actions .date-badge { display: none; }
            .modal-box.map-modal { height: 95vh; max-height: none; border-radius: 20px; }
            .map-toolbar .search-input { min-width: 100px; }
            .map-footer { flex-direction: column; align-items: stretch; }
            .map-footer .address-info { justify-content: center; }
            .map-footer .btn-group { justify-content: center; }
        }
        @media (max-width: 500px) {
            .stats-grid { grid-template-columns: 1fr; }
            .sidebar { width: 50px; }
            .sidebar nav button { width: 36px; height: 36px; font-size: 14px; }
            .main-content { margin-right: 50px; padding: 10px; }
            table { font-size: 12px; }
            th, td { padding: 10px 8px; }
            .action-btns button { width: 28px; height: 28px; font-size: 12px; }
            #toast { font-size: 12px; padding: 10px 18px; white-space: normal; }
        }
    </style>
</head>
<body>

    <!-- =========================================================
         الشريط الجانبي
    ========================================================= -->
    <aside class="sidebar" id="sidebar">
        <div class="logo"><i class="fas fa-kaaba"></i></div>
        <nav>
            <button class="active" title="لوحة التحكم"><i class="fas fa-chart-pie"></i></button>
            <button title="الحجاج" onclick="loadPilgrims()"><i class="fas fa-users"></i><span class="badge" id="sideBadge">0</span></button>
            <button title="المواقع" onclick="loadPilgrims()"><i class="fas fa-map-marked-alt"></i></button>
            <button title="الإعدادات" onclick="alert('قريباً')"><i class="fas fa-cog"></i></button>
        </nav>
    </aside>

    <!-- =========================================================
         المحتوى الرئيسي
    ========================================================= -->
    <main class="main-content" id="adminContent">
        <header class="topbar">
            <div class="greeting"><h2>👋 مرحباً، مدير الحج</h2><p id="currentDate">اليوم،</p></div>
            <div class="actions">
                <span class="date-badge"><i class="far fa-calendar-alt"></i> <span id="hijriDate">تحميل...</span></span>
                <button class="btn-outline" onclick="loadPilgrims()"><i class="fas fa-sync-alt"></i> تحديث</button>
                <button class="btn-primary" onclick="openAddModal()"><i class="fas fa-plus"></i> إضافة حاج</button>
            </div>
        </header>

        <div class="stats-grid">
            <div class="stat-card"><div class="icon"><i class="fas fa-users"></i></div><div class="label">إجمالي الحجاج</div><div class="value" id="totalPilgrims">0</div><div class="sub">مسجل في النظام</div></div>
            <div class="stat-card gold"><div class="icon"><i class="fas fa-map-pin"></i></div><div class="label">موقع محدد</div><div class="value" id="locatedPilgrims">0</div><div class="sub">تم تحديد مواقعهم</div></div>
            <div class="stat-card"><div class="icon"><i class="fas fa-clock"></i></div><div class="label">آخر إضافة</div><div class="value" id="lastAdded">-</div><div class="sub">أحدث حاج</div></div>
        </div>

        <div class="toolbar">
            <div class="search-box"><i class="fas fa-search"></i><input type="text" id="searchInput" placeholder="ابحث بالاسم، الكود، الجنسية أو الهاتف..." onkeyup="filterTable()"></div>
            <div class="left-actions">
                <button class="btn-outline" onclick="exportCSV()" style="padding:8px 16px;"><i class="fas fa-file-csv"></i> CSV</button>
            </div>
        </div>

        <div class="table-wrapper">
            <table>
                <thead><tr><th>#</th><th>الحاج</th><th>الكود</th><th>رقم الهاتف</th><th>الجنسية</th><th>تاريخ الإضافة</th><th>الموقع</th><th>الإجراءات</th></tr></thead>
                <tbody id="pilgrimsTableBody"><tr><td colspan="8" style="text-align:center;padding:40px;color:#a0aec0;">جاري تحميل البيانات...</td></tr></tbody>
            </table>
        </div>
    </main>

    <!-- =========================================================
         مودال الإضافة / التعديل
    ========================================================= -->
    <div class="modal-overlay" id="addEditModal">
        <div class="modal-box">
            <div class="modal-header"><h2 id="modalTitle"><i class="fas fa-user-plus"></i> إضافة حاج</h2><button class="close-modal" onclick="closeModal('addEditModal')">&times;</button></div>
            <input type="hidden" id="editId">
            <div class="form-row"><div class="form-group"><label>اسم الحاج</label><input type="text" id="inputName" placeholder="أحمد"></div><div class="form-group"><label>الشفرة</label><input type="text" id="inputCode" placeholder="1234"></div></div>
            <div class="form-row"><div class="form-group"><label>رقم الهاتف</label><input type="text" id="inputPhone" placeholder="0501234567"></div><div class="form-group"><label>الجنسية</label><input type="text" id="inputNationality" placeholder="سعودي"></div></div>
            <div class="form-group"><label>معرف المستخدم (اختياري)</label><input type="text" id="inputUserId" placeholder="اتركه فارغاً"></div>
            <button class="btn-save" onclick="savePilgrim()"><i class="fas fa-save"></i> حفظ البيانات</button>
        </div>
    </div>

    <!-- =========================================================
         مودال الخريطة المتطور (مع زر خرائط جوجل)
    ========================================================= -->
    <div class="modal-overlay" id="locationModal">
        <div class="modal-box map-modal">
            <!-- رأس المودال -->
            <div class="map-header">
                <h2><i class="fas fa-map-marked-alt"></i> موقع الحاج</h2>
                <button class="close-modal" onclick="closeModal('locationModal')">&times;</button>
            </div>
            
            <!-- شريط أدوات الخريطة -->
            <div class="map-toolbar">
                <input type="text" class="search-input" id="mapSearchInput" placeholder="🔍 ابحث عن مكان (مكة، الحرم، ...)" onkeydown="if(event.key==='Enter') searchLocation()">
                <button class="btn-icon gold" onclick="searchLocation()" title="بحث"><i class="fas fa-search"></i></button>
            </div>
            
            <!-- الخريطة -->
            <div id="locationMap"></div>
            
            <!-- تذييل المودال -->
            <div class="map-footer">
                <div class="address-info">
                    <i class="fas fa-location-dot"></i>
                    <span id="selectedAddress">اضغط على الخريطة لتعديل الموقع</span>
                </div>
                <div class="btn-group">
                    <button class="btn-google" id="googleMapsBtn" onclick="openInGoogleMaps()">
                        <i class="fas fa-map"></i> خرائط جوجل
                    </button>
                    <button class="btn-save-location" onclick="saveLocation()"><i class="fas fa-check-circle"></i> حفظ</button>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================
         Toast
    ========================================================= -->
    <div id="toast"></div>

    <!-- =========================================================
         المكتبات
    ========================================================= -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // =================================================================
        // 1. الإعدادات العامة
        // =================================================================
        const SUPABASE_URL = "https://tmmspfxkmqsivpxchfkk.supabase.co";
        const SUPABASE_ANON_KEY = "sb_publishable_e_UeWsqQTEk0GUhdpMDHYg_nAC3b7vZ";
        const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        let allPilgrims = [];
        let currentLocationPilgrimId = null;
        let currentLocationName = '';
        let map = null, marker = null;
        let currentLat = null, currentLng = null;
        let hasExistingLocation = false;

        // =================================================================
        // 2. التاريخ
        // =================================================================
        function updateDateTime() {
            const now = new Date();
            document.getElementById('currentDate').textContent = now.toLocaleDateString('ar-SA', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });
            try { document.getElementById('hijriDate').textContent = new Intl.DateTimeFormat('ar-SA-u-ca-islamic', { day: 'numeric', month: 'long', year: 'numeric' }).format(now); } catch(e) { document.getElementById('hijriDate').textContent = '--'; }
        }

        // =================================================================
        // 3. تحميل البيانات وعرضها
        // =================================================================
        function showToast(msg, isError = false) {
            const t = document.getElementById('toast');
            t.innerHTML = `<i class="fas ${isError ? 'fa-exclamation-circle' : 'fa-check-circle'}"></i> ${msg}`;
            t.className = 'show' + (isError ? ' error' : '');
            clearTimeout(t._timer);
            t._timer = setTimeout(() => t.classList.remove('show'), 4000);
        }

        async function loadPilgrims() {
            const tbody = document.getElementById('pilgrimsTableBody');
            tbody.innerHTML = Array(5).fill(0).map(() => `<tr>${Array(8).fill(0).map(() => `<td><div class="skeleton" style="height:20px;width:80px;"></div></td>`).join('')}</tr>`).join('');
            try {
                const { data, error } = await supabase.from('pilgrims').select('*').order('id', { ascending: false });
                if (error) throw new Error(error.message);
                allPilgrims = data || [];
                renderTable(allPilgrims);
                updateStats(allPilgrims);
                document.getElementById('sideBadge').textContent = allPilgrims.length;
            } catch (e) { 
                tbody.innerHTML = `<tr><td colspan="8" style="text-align:center;padding:40px;color:#e53e3e;"><i class="fas fa-exclamation-triangle"></i> ${e.message}</td></tr>`;
                showToast('❌ ' + e.message, true);
            }
        }

        function renderTable(list) {
            const tbody = document.getElementById('pilgrimsTableBody');
            if (!list || list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" style="text-align:center;padding:40px;color:var(--text-muted);"><i class="fas fa-user-slash" style="font-size:40px;display:block;margin-bottom:10px;"></i> لا يوجد حجاج مسجلين</td></tr>`;
                return;
            }
            tbody.innerHTML = list.map((p, i) => {
                const hasLoc = p.latitude && p.longitude;
                const date = p.created_at ? new Date(p.created_at).toLocaleDateString('ar-SA') : '-';
                const initial = p.name ? p.name.charAt(0) : 'ح';
                return `<tr>
                    <td>${i+1}</td>
                    <td><div style="display:flex;align-items:center;gap:10px;"><div class="pilgrim-avatar">${initial}</div><strong>${esc(p.name)}</strong></div></td>
                    <td><span style="font-family:monospace;background:var(--bg);padding:4px 8px;border-radius:8px;">${esc(p.code)}</span></td>
                    <td>${esc(p.phone||'-')}</td>
                    <td><span class="status-badge active" style="background:var(--gold-light);color:var(--gold);">${esc(p.nationality||'-')}</span></td>
                    <td>${date}</td>
                    <td><span class="status-badge ${hasLoc?'active':'inactive'}"><span class="status-dot ${hasLoc?'green':'gray'}"></span> ${hasLoc?'محدد':'غير محدد'}</span></td>
                    <td><div class="action-btns">
                        <button class="loc-btn" onclick="openLocationModal('${p.id}','${esc(p.name)}')"><i class="fas fa-map-pin"></i></button>
                        <button class="edit-btn" onclick="openEditModal('${p.id}','${esc(p.name)}','${esc(p.code)}','${esc(p.phone||'')}','${esc(p.nationality||'')}','${esc(p.user_id||'')}')"><i class="fas fa-edit"></i></button>
                        <button class="del-btn" onclick="deletePilgrim('${p.id}','${esc(p.name)}')"><i class="fas fa-trash"></i></button>
                    </div></td>
                </tr>`;
            }).join('');
        }

        function esc(t) { if(!t) return ''; return String(t).replace(/[&<>"]/g, m => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[m] || m)); }

        function updateStats(data) {
            document.getElementById('totalPilgrims').textContent = data.length;
            document.getElementById('locatedPilgrims').textContent = data.filter(p=>p.latitude&&p.longitude).length;
            if(data.length && data[0].created_at) {
                document.getElementById('lastAdded').textContent = new Date(data[0].created_at).toLocaleDateString('ar-SA');
            } else {
                document.getElementById('lastAdded').textContent = '-';
            }
        }

        function filterTable() {
            const q = document.getElementById('searchInput').value.trim().toLowerCase();
            if(!q) return renderTable(allPilgrims);
            renderTable(allPilgrims.filter(p =>
                p.name.toLowerCase().includes(q) ||
                p.code.toLowerCase().includes(q) ||
                (p.phone && p.phone.includes(q)) ||
                (p.nationality && p.nationality.toLowerCase().includes(q))
            ));
        }

        // =================================================================
        // 4. الإضافة والتعديل والحذف
        // =================================================================
        function openAddModal() {
            document.getElementById('modalTitle').innerHTML = '<i class="fas fa-user-plus"></i> إضافة حاج';
            document.getElementById('editId').value = '';
            ['inputName','inputCode','inputPhone','inputNationality','inputUserId'].forEach(id => document.getElementById(id).value = '');
            document.getElementById('addEditModal').classList.add('show');
        }

        function openEditModal(id, name, code, phone, nationality, userId) {
            document.getElementById('modalTitle').innerHTML = '<i class="fas fa-edit"></i> تعديل حاج';
            document.getElementById('editId').value = id;
            document.getElementById('inputName').value = name;
            document.getElementById('inputCode').value = code;
            document.getElementById('inputPhone').value = phone;
            document.getElementById('inputNationality').value = nationality;
            document.getElementById('inputUserId').value = userId;
            document.getElementById('addEditModal').classList.add('show');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('show');
            if(id === 'locationModal' && map) { map.remove(); map = null; }
        }

        async function savePilgrim() {
            const id = document.getElementById('editId').value;
            const name = document.getElementById('inputName').value.trim();
            const code = document.getElementById('inputCode').value.trim();
            const phone = document.getElementById('inputPhone').value.trim();
            const nationality = document.getElementById('inputNationality').value.trim();
            const userId = document.getElementById('inputUserId').value.trim() || '00000000-0000-0000-0000-000000000000';

            if(!name || !code) { showToast('⚠️ الاسم والكود مطلوبان', true); return; }

            const payload = { name, code, phone, nationality, user_id: userId };
            try {
                let result;
                if(id) { result = await supabase.from('pilgrims').update(payload).eq('id', id); }
                else { result = await supabase.from('pilgrims').insert([payload]); }
                if(result.error) throw new Error(result.error.message);
                showToast(id ? '✅ تم التعديل' : '✅ تم الإضافة');
                closeModal('addEditModal');
                loadPilgrims();
            } catch(e) { showToast('❌ ' + e.message, true); }
        }

        async function deletePilgrim(id, name) {
            if(!confirm(`حذف "${name}" نهائياً؟`)) return;
            try {
                const { error } = await supabase.from('pilgrims').delete().eq('id', id);
                if(error) throw new Error(error.message);
                showToast('🗑️ تم حذف ' + name);
                loadPilgrims();
            } catch(e) { showToast('❌ ' + e.message, true); }
        }

        // =================================================================
        // 5. الخريطة - عرض موقع الحاج فقط (بدون تحديد موقع المدير)
        // =================================================================
        function openLocationModal(id, name) {
            currentLocationPilgrimId = id;
            currentLocationName = name;
            hasExistingLocation = false;
            
            document.getElementById('locPilgrimName').textContent = '📍 الحاج: ' + name;
            document.getElementById('locLat').value = '';
            document.getElementById('locLng').value = '';
            document.getElementById('selectedAddress').textContent = 'جاري تحميل الموقع...';
            
            // تعطيل زر جوجل مابس مؤقتاً
            document.getElementById('googleMapsBtn').classList.add('disabled');
            
            document.getElementById('locationModal').classList.add('show');

            setTimeout(() => {
                if (map) map.remove();
                
                map = L.map('locationMap').setView([21.4225, 39.8262], 6);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { 
                    attribution: '© OpenStreetMap' 
                }).addTo(map);

                // جلب موقع الحاج من قاعدة البيانات
                supabase
                    .from('pilgrim_locations')
                    .select('*')
                    .eq('pilgrim_id', id)
                    .maybeSingle()
                    .then(({ data, error }) => {
                        if (error) {
                            showToast('❌ خطأ في جلب الموقع', true);
                            document.getElementById('selectedAddress').textContent = 'خطأ في التحميل';
                            return;
                        }

                        if (data && data.latitude && data.longitude) {
                            const lat = parseFloat(data.latitude);
                            const lng = parseFloat(data.longitude);
                            currentLat = lat;
                            currentLng = lng;
                            hasExistingLocation = true;
                            
                            document.getElementById('locLat').value = lat;
                            document.getElementById('locLng').value = lng;
                            document.getElementById('selectedAddress').textContent = `📍 ${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                            
                            // تفعيل زر جوجل مابس
                            document.getElementById('googleMapsBtn').classList.remove('disabled');
                            
                            // حرك الخريطة على موقع الحاج
                            map.setView([lat, lng], 15);
                            
                            // علامة مميزة للحاج
                            marker = L.marker([lat, lng], {
                                icon: L.divIcon({
                                    className: 'custom-marker',
                                    html: '<i class="fas fa-user-circle" style="font-size:42px;color:#075c52;"></i>',
                                    iconSize: [42, 42],
                                    iconAnchor: [21, 42]
                                })
                            }).addTo(map);
                            
                            // دائرة حول الموقع
                            L.circle([lat, lng], {
                                color: '#c99625',
                                fillColor: '#c99625',
                                fillOpacity: 0.12,
                                radius: 40
                            }).addTo(map);

                            showToast('✅ موقع الحاج ظاهر على الخريطة');
                        } else {
                            document.getElementById('selectedAddress').textContent = '⚠️ هذا الحاج لم يحدد موقعه بعد';
                            showToast('⚠️ هذا الحاج لم يحدد موقعه على الخريطة', true);
                        }
                    });

                // عند النقر على الخريطة (لتعديل الموقع)
                map.on('click', function(e) {
                    const lat = e.latlng.lat;
                    const lng = e.latlng.lng;
                    currentLat = lat;
                    currentLng = lng;
                    hasExistingLocation = true;
                    
                    document.getElementById('locLat').value = lat.toFixed(6);
                    document.getElementById('locLng').value = lng.toFixed(6);
                    document.getElementById('selectedAddress').textContent = `📍 ${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                    
                    // تفعيل زر جوجل مابس
                    document.getElementById('googleMapsBtn').classList.remove('disabled');
                    
                    if (marker) map.removeLayer(marker);
                    marker = L.marker([lat, lng]).addTo(map);
                    showToast('📍 تم تحديد موقع جديد للحاج، اضغط حفظ');
                });

            }, 300);
        }

        // =================================================================
        // 6. حفظ الموقع
        // =================================================================
        async function saveLocation() {
            const lat = parseFloat(document.getElementById('locLat').value);
            const lng = parseFloat(document.getElementById('locLng').value);
            
            if(isNaN(lat)||isNaN(lng)) { showToast('⚠️ يرجى اختيار موقع على الخريطة أولاً', true); return; }
            if(!currentLocationPilgrimId) { showToast('⚠️ خطأ في معرف الحاج', true); return; }
            
            try {
                const { error } = await supabase.from('pilgrim_locations').upsert({
                    pilgrim_id: currentLocationPilgrimId,
                    latitude: lat,
                    longitude: lng,
                    updated_at: new Date().toISOString()
                }, { onConflict: 'pilgrim_id' });
                
                if(error) throw new Error(error.message);
                
                showToast('✅ تم حفظ موقع الحاج بنجاح');
                document.getElementById('selectedAddress').textContent = `✅ تم الحفظ: ${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                closeModal('locationModal');
                loadPilgrims();
            } catch(e) { showToast('❌ ' + e.message, true); }
        }

        // =================================================================
        // 7. فتح الموقع في خرائط جوجل (الزر الجديد)
        // =================================================================
        function openInGoogleMaps() {
            const lat = parseFloat(document.getElementById('locLat').value);
            const lng = parseFloat(document.getElementById('locLng').value);
            
            if(!lat || !lng || isNaN(lat) || isNaN(lng)) {
                showToast('⚠️ لا يوجد موقع محدد للحاج', true);
                return;
            }
            
            // فتح خرائط جوجل في تطبيق الهاتف أو المتصفح
            const url = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
            window.open(url, '_blank');
            showToast('🗺️ جاري فتح خرائط جوجل...');
        }

        // =================================================================
        // 8. البحث عن موقع (ميزة إضافية)
        // =================================================================
        function searchLocation() {
            const query = document.getElementById('mapSearchInput').value.trim();
            if (!query) return;
            
            // استخدام Nominatim API للبحث (مجاني)
            fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=1`)
                .then(res => res.json())
                .then(data => {
                    if (data && data.length > 0) {
                        const lat = parseFloat(data[0].lat);
                        const lng = parseFloat(data[0].lon);
                        if (map) {
                            map.setView([lat, lng], 14);
                            if (marker) map.removeLayer(marker);
                            marker = L.marker([lat, lng]).addTo(map);
                            document.getElementById('locLat').value = lat.toFixed(6);
                            document.getElementById('locLng').value = lng.toFixed(6);
                            document.getElementById('selectedAddress').textContent = `📍 ${data[0].display_name}`;
                            showToast('✅ تم العثور على الموقع');
                        }
                    } else {
                        showToast('⚠️ لم يتم العثور على الموقع', true);
                    }
                })
                .catch(() => showToast('❌ خطأ في البحث', true));
        }

        // =================================================================
        // 9. تصدير CSV
        // =================================================================
        function exportCSV() {
            if(!allPilgrims || allPilgrims.length === 0) { showToast('لا توجد بيانات', true); return; }
            let csv = "الاسم,الكود,الهاتف,الجنسية,المعرف,التاريخ,الموقع\n";
            allPilgrims.forEach(p => {
                csv += `"${p.name}","${p.code}","${p.phone||''}","${p.nationality||''}","${p.user_id||''}","${p.created_at?new Date(p.created_at).toLocaleDateString('ar-SA'):''}","${p.latitude&&p.longitude?'محدد':'غير محدد'}"\n`;
            });
            const blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `الحجاج_${new Date().toISOString().slice(0,10)}.csv`;
            link.click();
            showToast('📥 تم التصدير');
        }

        // =================================================================
        // 10. التشغيل الأولي
        // =================================================================
        document.addEventListener('DOMContentLoaded', () => {
            loadPilgrims();
            updateDateTime();
            console.log('✅ لوحة الإدارة - نسخة الخريطة المتطورة مع زر جوجل مابس');
        });
    </script>
</body>
</html>
